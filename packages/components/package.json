{
  "name": "upthrust-ui",
  "version": "0.0.1",
  "description": "A simple solid ui lib built with unocss",
  "keywords": [
    "solid",
    "unocss",
    "vite",
    "component",
    "ui",
    "solid admin",
    "solid component"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./lib/index.ts",
      "types": "./types/index.d.ts",
      "require": "./dist/upthrust.cjs",
      "import": "./dist/upthrust.js"
    },
    "./es": {
      "types": "./types/index.d.ts",
      "import": "./dist/es/index.js"
    },
    "./es/*": {
      "types": "./types/*/index.d.ts",
      "import": "./dist/es/*/index.js"
    },
    "./source": {
      "source": "./lib/index.ts",
      "types": "./lib/index.ts"
    },
    "./source/*": {
      "source": "./lib/*/index.tsx",
      "types": "./lib/*/index.tsx"
    },
    "./style.css": {
      "import": "./dist/upthrust.css"
    }
  },
  "main": "./dist/upthrust.cjs",
  "module": "./dist/es/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types",
    "lib"
  ],
  "scripts": {
    "watch": "vite build --mode watch",
    "build": "vite build && vite build --mode preserve",
    "build:bundle": "vite build",
    "build:es": "vite build --mode preserve",
    "test": "pnpm --dir ../testing run test:render"
  },
  "license": "MIT",
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.0",
    "dayjs": "^1.11.0",
    "solid-js": "^2.0.0-rc.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@types/lodash": "^4.17.25",
    "@types/qrcode-generator": "^1.0.6",
    "@unocss/preset-icons": "~66.7.5",
    "@unocss/preset-wind4": "~66.7.5",
    "@unocss/transformer-compile-class": "~66.7.5",
    "clsx": "^2.1.1",
    "lodash": "^4.18.1",
    "qrcode-generator": "^2.0.4",
    "upthrust-competence": "workspace:^",
    "upthrust-unocss-preset": "workspace:^"
  }
}
