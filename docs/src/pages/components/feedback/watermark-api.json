[
  { "name": "width", "type": "number", "default": "图片 120；文字按内容测量", "description": "单个水印的宽度" },
  { "name": "height", "type": "number", "default": "图片 64；文字按内容测量", "description": "单个水印的高度" },
  { "name": "inherit", "type": "boolean", "default": "true", "description": "是否将水印传导给 Modal / Drawer 等弹出面板" },
  { "name": "rotate", "type": "number", "default": "-22", "description": "绘制水印时的旋转角度（°）" },
  { "name": "zIndex", "type": "number", "default": "999", "description": "追加的水印元素的 z-index" },
  { "name": "image", "type": "string", "default": "—", "description": "图片源，优先级高于文字；加载失败回退为文字" },
  { "name": "content", "type": "string | WatermarkText | (string | WatermarkText)[]", "default": "—", "description": "水印文字内容；数组为多行" },
  { "name": "font", "type": "WatermarkFont", "default": "见下表", "description": "文字样式" },
  { "name": "gap", "type": "[number, number]", "default": "[100, 100]", "description": "水印之间的间距" },
  { "name": "offset", "type": "[number, number]", "default": "[gap[0] / 2, gap[1] / 2]", "description": "水印距离容器左上角的偏移量" },
  { "name": "onRemove", "type": "() => void", "default": "—", "description": "水印被外部 DOM 操作移除（并已自动恢复）时触发" }
]
