  { "name": "onChange", "type": "(affixed: boolean) => void", "default": "—", "description": "固定状态切换时回调（只在切换时触发）" },
  { "name": "disabled", "type": "boolean", "default": "false", "description": "禁用固定，恢复文档流" },
  { "name": "zIndex", "type": "number", "default": "10", "description": "固定时内容层的 z-index" },
  { "name": "class", "type": "string", "default": "—", "description": "占位外层类名" },
  { "name": "style", "type": "JSX.CSSProperties", "default": "—", "description": "占位外层样式" },
  { "name": "affixClass", "type": "string", "default": "—", "description": "仅在固定时作用于内容层的类名" },
  { "name": "ref", "type": "(instance: AffixIns) => void", "default": "—", "description": "取得 headless 实例：updatePosition()、affixed()、position()" }
