[
  { "name": "offsetTop", "type": "number", "default": "0", "description": "距目标可视区域顶部达到该值时固定；offsetTop 与 offsetBottom 都未设置时为 0" },
  { "name": "offsetBottom", "type": "number", "default": "—", "description": "距目标可视区域底部达到该值时固定；与 offsetTop 同时设置时两者都生效，都满足时顶部优先" },
