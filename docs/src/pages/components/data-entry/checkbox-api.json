  },
  {
    "name": "class",
    "type": "string",
    "default": "—",
    "description": "外层容器类名。"
  },
  {
    "name": "style",
    "type": "JSX.CSSProperties",
    "default": "—",
    "description": "外层容器样式。"
  },
  {
    "name": "children",
    "type": "JSX.Element",
    "default": "—",
    "description": "标签内容。"
