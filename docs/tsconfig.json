{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "preserve", "jsxImportSource": "@solidjs/web", "strict": true,
    "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true, "esModuleInterop": true,
    "resolveJsonModule": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "plugins"]
}
