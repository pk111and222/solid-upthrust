{
  "name": "upthrust-ui",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir packages/testing run test",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "dev::preset": "pnpm --dir packages/preset run watch",
    "dev::competence": "pnpm --dir packages/competence run watch",
    "dev::component": "pnpm --dir packages/components run watch",
    "dev::example": "pnpm --dir example run dev",
    "build": "pnpm --dir packages/preset run build && pnpm --dir packages/competence run build && pnpm --dir packages/components run build && pnpm --dir example run build",
    "test:headless": "pnpm --dir packages/testing run test:headless",
    "test:smoke": "pnpm --dir packages/testing run test:smoke",
    "test:render": "pnpm --dir packages/testing run test:render",
    "test:watch": "pnpm --dir packages/testing run test:watch",
    "dev:docs": "pnpm --dir docs run dev",
    "build:docs": "pnpm --dir docs run build",
    "preview:docs": "pnpm --dir docs run preview",
    "typecheck:docs": "pnpm --dir docs run typecheck",
    "check:docs": "pnpm run typecheck:docs && pnpm run build:docs",
    "test:docs": "pnpm --dir packages/testing run test:docs",
    "test:docs:browser": "pnpm --dir packages/testing run test:docs:browser"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Upthrust/upthrust-ui.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@typescript/typescript6": "npm:typescript@^5.8.3",
    "@unocss/preset-icons": "~66.7.5",
    "@unocss/preset-wind4": "~66.7.5",
    "@unocss/vite": "~66.7.5",
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-solid": "^3.0.0-next.27",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "dependencies": {
    "dayjs": "^1.11.23"
  }
}
